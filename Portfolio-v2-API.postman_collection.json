      "value": "",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "postSlug",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
