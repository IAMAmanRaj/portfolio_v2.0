              ]
            },
            "description": "ADMIN only. Creates another ADMIN account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newadmin@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"New Admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete Admin (SUPER_ADMIN only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/admins/{{targetAdminId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "admins",
                "{{targetAdminId}}"
              ]
            },
            "description": "SUPER_ADMIN only - stricter than the other admin routes. Log in as Super Admin first, or expect 403. Cannot delete your own account or the super admin itself."
          },
          "response": []
