      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0 - Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "No auth. First thing to hit - confirms the server is up before anything else. If this fails, nothing else will work - check the server is running with `npm run dev` in server/."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "Login - Super Admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the seeded SUPER_ADMIN. Can do everything, including things ADMIN cannot.\n\nSets two cookies: auth_token (httpOnly - you can't read it, the browser/client just sends it back automatically) and csrf_token (readable, must be echoed as the x-csrf-token header on every mutating request). The test script below reads the csrf_token cookie and stores it as {{csrfToken}} automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const csrf = pm.cookies.get('csrf_token');",
                  "if (csrf) { pm.collectionVariables.set('csrfToken', csrf); console.log('csrfToken captured:', csrf); }",
                  "else { console.warn('No csrf_token cookie found - set csrfToken manually if your client does not auto-manage cookies.'); }",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Session (auth/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns id, email, displayName, role, bio, avatarUrl for whoever's auth_token cookie is currently set. Run it after any login to confirm the cookie took."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Sample Admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the seeded ADMIN (not SUPER_ADMIN). One tier down - can manage categories, authors, and other admins, but not delete admins or touch the super admin.\n\nSets two cookies: auth_token (httpOnly - you can't read it, the browser/client just sends it back automatically) and csrf_token (readable, must be echoed as the x-csrf-token header on every mutating request). The test script below reads the csrf_token cookie and stores it as {{csrfToken}} automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{samplePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const csrf = pm.cookies.get('csrf_token');",
                  "if (csrf) { pm.collectionVariables.set('csrfToken', csrf); console.log('csrfToken captured:', csrf); }",
                  "else { console.warn('No csrf_token cookie found - set csrfToken manually if your client does not auto-manage cookies.'); }",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Author One",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in as author1@example.com. AUTHOR role - can only manage their OWN posts. One half of the pair used to prove authors can't touch each other's content.\n\nSets two cookies: auth_token (httpOnly - you can't read it, the browser/client just sends it back automatically) and csrf_token (readable, must be echoed as the x-csrf-token header on every mutating request). The test script below reads the csrf_token cookie and stores it as {{csrfToken}} automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{author1Email}}\",\n  \"password\": \"{{samplePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const csrf = pm.cookies.get('csrf_token');",
                  "if (csrf) { pm.collectionVariables.set('csrfToken', csrf); console.log('csrfToken captured:', csrf); }",
                  "else { console.warn('No csrf_token cookie found - set csrfToken manually if your client does not auto-manage cookies.'); }",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Author Two",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in as author2@example.com - the other half of the AUTHOR pair. Use this to attempt editing Author One's post later and confirm a 403.\n\nSets two cookies: auth_token (httpOnly - you can't read it, the browser/client just sends it back automatically) and csrf_token (readable, must be echoed as the x-csrf-token header on every mutating request). The test script below reads the csrf_token cookie and stores it as {{csrfToken}} automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{author2Email}}\",\n  \"password\": \"{{samplePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const csrf = pm.cookies.get('csrf_token');",
                  "if (csrf) { pm.collectionVariables.set('csrfToken', csrf); console.log('csrfToken captured:', csrf); }",
                  "else { console.warn('No csrf_token cookie found - set csrfToken manually if your client does not auto-manage cookies.'); }",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Clears both cookies. No CSRF header needed - logout is deliberately exempt."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Users",
      "item": [
        {
          "name": "Update My Profile (self-service)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Any authenticated role. Always edits the CALLER's own account - there's no way to pass someone else's id here. Cannot touch email or role, only displayName/bio/avatarUrl.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Author One (edited)\",\n  \"bio\": \"Backend dev, testing my own API.\",\n  \"avatarUrl\": \"https://example.com/avatar.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List Authors (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/authors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "authors"
              ]
            },
            "description": "ADMIN or SUPER_ADMIN only. Lists every AUTHOR account. Log in as Sample Admin first - if logged in as an AUTHOR, expect 403."
          },
          "response": []
        },
        {
          "name": "Create Author (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "ADMIN only. Creates a new AUTHOR account outside the seed script.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newauthor@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"New Author\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Change User Role (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{targetUserId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{targetUserId}}",
                "role"
