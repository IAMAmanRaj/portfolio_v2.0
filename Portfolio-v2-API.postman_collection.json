      ]
    },
    {
      "name": "3 - Categories",
      "item": [
        {
          "name": "List Categories (flat)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Public, no auth. Flat list ordered by sortOrder then name - what an admin dropdown would use."
          },
          "response": []
        },
        {
          "name": "List Categories (tree)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories?tree=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ],
              "query": [
                {
                  "key": "tree",
                  "value": "true"
                }
              ]
            },
            "description": "Public. Same data, nested into parent/children - what a public nav menu would use."
          },
          "response": []
        },
        {
          "name": "Get Category by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categorySlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categorySlug}}"
              ]
            },
            "description": "Public. {{categorySlug}} gets set automatically after you create one below."
          },
          "response": []
        },
        {
          "name": "Create Category - Parent (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "ADMIN/SUPER_ADMIN only - stricter than posts, since categories are site structure. Run this while logged in as Sample Admin. Captures {{categoryId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Technology\",\n  \"description\": \"Posts about software and tools\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('categoryId', body.category.id);",
                  "  pm.collectionVariables.set('categorySlug', body.category.slug);",
                  "  console.log('categoryId captured:', body.category.id);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Category - Child (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Same role requirement. parentId links this under {{categoryId}} - the self-referencing relation: Category.parentId -> Category.id, one parent, many children. Captures {{categoryChildId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Web Development\",\n  \"parentId\": \"{{categoryId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('categoryChildId', pm.response.json().category.id);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Category (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryChildId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categoryChildId}}"
              ]
            },
            "description": "ADMIN/SUPER_ADMIN only.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Frontend and backend web dev posts\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete Parent - expect 409",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categoryId}}"
              ]
            },
            "description": "Try this WHILE the child category still exists. Expect 409: the service blocks deleting a category that still has children, rather than cascading."
          },
          "response": []
        },
        {
          "name": "Delete Child (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryChildId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categoryChildId}}"
              ]
            },
            "description": "Deletes the child - no children of its own, so this succeeds (204)."
          },
          "response": []
        },
        {
          "name": "Delete Parent - now succeeds",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{categoryId}}"
              ]
            },
