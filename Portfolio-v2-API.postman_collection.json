            },
            "description": "ADMIN only. Set {{targetUserId}} to a real user id first (e.g. from 'List Authors'). SUPER_ADMIN can never be assigned or changed via this route.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Update User (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{targetUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{targetUserId}}"
              ]
            },
            "description": "ADMIN only. Edits displayName/role for another user by id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Renamed by Admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete Author (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{targetUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{targetUserId}}"
              ]
            },
            "description": "ADMIN only. Deletes an AUTHOR account. Cannot delete your own account, and cannot target an ADMIN or SUPER_ADMIN through this route."
          },
          "response": []
        },
        {
          "name": "Create Admin (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/admins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
