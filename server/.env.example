# Database URLs
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT].supabase.co:6543/postgres?pgbouncer=true"

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET="your-secret-key"
CLIENT_ORIGIN="http://localhost:5173"
JWT_EXPIRES_IN="1d"
AUTH_COOKIE_NAME="auth_token"
CSRF_COOKIE_NAME="csrf_token"

# ImageKit (featured image uploads — https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PUBLIC_KEY="public_..."
IMAGEKIT_PRIVATE_KEY="private_..."
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# Prisma seed (run from server/: `npx prisma db seed`)
SEED_SUPER_ADMIN_EMAIL="super-admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="super_admin_password"
# Optional display name for the seeded super admin
# SEED_SUPER_ADMIN_DISPLAY_NAME="Super Admin"

# Sample ADMIN + 2 AUTHOR accounts are seeded automatically when
# NODE_ENV is not "production", for testing role-scoped behaviour.
# Both passwords below are required (seeding throws without them).
# The admin gets its own password; both sample authors share the one
# author password between them (not per-author — they exist to test
# author-vs-author permission boundaries, not credential isolation).
SEED_ADMIN_PASSWORD="change-me-at-least-6-chars"
SEED_AUTHOR_PASSWORD="change-me-at-least-6-chars-too"
# Optional — defaults to admin@example.com if unset
# SEED_ADMIN_EMAIL="admin@example.com"
